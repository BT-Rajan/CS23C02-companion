# Copy to android/.env (git-ignored). Build-time only: the values are baked into the APK, so NEVER put secrets here.
# GitHub builds read the same names from repository variables (Settings > Secrets and variables > Actions > Variables).
API_BASE_URL=https://api.example.com
# Optional until the API client lands; comma-separated SPKI pins, e.g. sha256/AAAA...=,sha256/BBBB...=  (primary + backup)
API_CERT_PINS=
# base64 Ed25519 PUBLIC key that signs content packages (content-tools keygen prints it). Public by design; required for release.
CONTENT_SIGNING_PUBKEY=
