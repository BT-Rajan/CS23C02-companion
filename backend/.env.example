# Copy to .env (never commit .env). Generate each secret with: openssl rand -hex 32
ENV=dev
DATABASE_URL=mysql+pymysql://cs23c02_app:CHANGE_ME@127.0.0.1:3306/cs23c02?charset=utf8mb4
# Alembic uses this (migration user with DDL rights); falls back to DATABASE_URL
MIGRATION_DATABASE_URL=mysql+pymysql://cs23c02_migrator:CHANGE_ME@127.0.0.1:3306/cs23c02?charset=utf8mb4

JWT_SECRET=generate-with-openssl-rand-hex-32
CODE_PEPPER=generate-with-openssl-rand-hex-32
AUX_PEPPER=generate-with-openssl-rand-hex-32

# Gmail SMTP (needs 2-Step Verification + an App Password). See docs/ops/gmail-smtp.md
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false
